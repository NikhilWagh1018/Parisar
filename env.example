# --- Database (backup-cron reads these; wire via Railway Variable Reference picker) ---
DB_HOST="${{MySQL.MYSQLHOST}}"
DB_PORT="${{MySQL.MYSQLPORT}}"
DB_USER="${{MySQL.MYSQLUSER}}"
DB_PASS="${{MySQL.MYSQLPASSWORD}}"
DB_NAME="${{MySQL.MYSQLDATABASE}}"

# --- Backblaze B2 (S3-compatible) backup storage ---
BACKUP_S3_ENDPOINT="https://s3.us-east-005.backblazeb2.com"
BACKUP_S3_BUCKET="cycleaudit-backups"
BACKUP_S3_ACCESS_KEY="your-b2-keyID"
BACKUP_S3_SECRET_KEY="your-b2-applicationKey"

# --- Backup retention ---
# Number of days of backups to keep in the B2 bucket before pruning.
RETENTION_DAYS="7"
