# ──────────────────────────────────────────────────────────────
#  .env.example — copy this to .env for local development
#  Never commit .env to git. Railway uses its own env variables.
# ──────────────────────────────────────────────────────────────

# ── Database (XAMPP defaults) ──────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=parisar_db
DB_USER=root
DB_PASS=

# ── Application ────────────────────────────────────────────────
BASE_URL=http://localhost/Parisar

# ── Google OAuth ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost/Parisar/auth/google_callback.php

# ── Automated backups (see BACKUPS.md) ─────────────────────────
# Only needed on the separate Railway "backup" cron service, not
# the main web service. Uses the same DB_HOST/DB_NAME/DB_USER/DB_PASS
# above to connect, plus these for uploading to object storage:
BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=cycleaudit-backups
BACKUP_S3_ACCESS_KEY=your-r2-access-key
BACKUP_S3_SECRET_KEY=your-r2-secret-key
BACKUP_RETENTION_DAYS=7