<?xml version="1.0" encoding="UTF-8"?>
<!-- phpunit.xml — PHPUnit 10 configuration for Parisar CycleAudit -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         stopOnFailure="false">

    <testsuites>
        <testsuite name="Unit">
            <file>tests/ScoreServiceTest.php</file>
            <file>tests/ScoringEngineTest.php</file>
            <file>tests/ValidatorTest.php</file>
            <file>tests/CityScopeTest.php</file>
            <file>tests/RoadRepositoryCityTest.php</file>
            <file>tests/CitiesTest.php</file>
            <file>tests/RoleHomeTest.php</file>
            <file>tests/RoleRulesTest.php</file>
            <file>tests/CityLeaderGateTest.php</file>
            <file>tests/CityAuditTest.php</file>
            <file>tests/CityAuditRepositoryTest.php</file>
            <file>tests/SurveyorWorkTest.php</file>
            <file>tests/AuditReviewTest.php</file>
            <file>tests/SurveyorAssignedOnlyTest.php</file>
            <file>tests/CityDashboardTest.php</file>
        </testsuite>
        <testsuite name="Integration">
            <file>tests/SegmentRepositoryTest.php</file>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>services</directory>
            <directory>helpers</directory>
            <directory>repositories</directory>
            <directory>config</directory>
        </include>
        <exclude>
            <directory>vendor</directory>
            <directory>tests</directory>
        </exclude>
    </source>

</phpunit>
