{
    "name": "parisar/cycleaudit",
    "description": "Parisar CycleAudit \u2014 road segment audit platform",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "mpdf/mpdf": "^8.2",
        "phpoffice/phpspreadsheet": "^2.3",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload-dev": {
        "classmap": [
            "tests/"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.1.34",
            "ext-gd": "8.1.34"
        }
    },
    "scripts": {
        "test": "phpunit --testdox"
    }
}