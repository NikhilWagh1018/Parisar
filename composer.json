{
    "name": "parisar/cycleaudit",
    "description": "Parisar CycleAudit - road segment audit platform",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "mpdf/mpdf": "^8.2",
        "phpoffice/phpspreadsheet": "^2.3",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {},
    "autoload-dev": {
        "psr-4": {
            "Parisar\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit --testdox"
    }
}
