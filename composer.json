{
    "name": "parisar/cycleaudit",
    "description": "Parisar CycleAudit — road segment audit platform",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Parisar\\": "src/"
        },
        
    },
    "autoload-dev": {
        "psr-4": {
            "Parisar\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit --testdox"
    }
}

